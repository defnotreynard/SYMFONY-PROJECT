<section id="hero" class="hero-gradient py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="lg:grid lg:grid-cols-2 lg:gap-12 items-center">
      {% set hero = { title: 'Streamlining Your Celebrations', subtitle: 'Event Planning, Services, and Booking in One Place', cta_primary: { text: 'Explore Packages', link: '#packages' }, cta_secondary: { text: 'Book Now', link: '#booking' }, image: 'http://static.photos/event/1200x630/1' } %}

      <!-- Text Section -->
      <div class="mb-10 lg:mb-0" data-aos="fade-right">
        <h1 class="text-4xl md:text-5xl font-bold text-gray-800 mb-6">{{ hero.title }}</h1>
        <p class="text-lg text-gray-600 mb-8">{{ hero.subtitle }}</p>

        <div class="flex space-x-4">
          <a href="{{ hero.cta_primary.link }}" class="bg-primary text-white px-6 py-3 rounded-full font-medium hover:bg-opacity-90 transition">{{ hero.cta_primary.text }}</a>
          <a href="{{ hero.cta_secondary.link }}" class="border-2 border-primary text-primary px-6 py-3 rounded-full font-medium hover:bg-primary hover:text-white transition">{{ hero.cta_secondary.text }}</a>
        </div>
      </div>

      <!-- Image Section -->
      <div data-aos="fade-left">
        <img src="{{ hero.image }}" alt="{{ hero.title }}" class="rounded-xl shadow-lg" />
      </div>
    </div>
  </div>
</section>
