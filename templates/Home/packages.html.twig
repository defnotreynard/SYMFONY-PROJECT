{# templates/sections/packages.html.twig #}

<section id="packages" class="py-16 bg-secondary">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl font-bold text-gray-800 mb-4" data-aos="fade-up">Our Packages</h2>
      <div class="w-20 h-1 bg-primary mx-auto"></div>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      {% set packages = [{ icon: 'heart', title: 'Wedding Essentials', price: '₱50,000 – ₱80,000', features: ['Venue styling and basic decor', 'Buffet catering for 100 guests', '6-hour photography coverage', 'Basic sound system'] }, { icon: 'briefcase', title: 'Corporate Classic', price: '₱30,000 – ₱60,000', features: ['Professional venue setup', 'Coffee breaks and lunch service', 'AV equipment and technical support', 'Event documentation'] }, { icon: 'gift', title: 'Birthday Bliss', price: '₱20,000 – ₱40,000', features: ['Thematic decorations', 'Food for 50 guests', 'Custom birthday cake', 'Basic photo coverage'] }] %}

      {% for package in packages %}
        <div class="bg-white rounded-xl shadow-md overflow-hidden" data-aos="fade-up" data-aos-delay="{{ loop.index * 100 }}">
          <div class="h-48 bg-primary bg-opacity-10 flex items-center justify-center">
            <i data-feather="{{ package.icon }}" class="text-primary w-12 h-12"></i>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold text-gray-800 mb-2">{{ package.title }}</h3>
            <p class="text-primary font-bold mb-4">{{ package.price }}</p>
            <ul class="space-y-2 mb-6">
              {% for feature in package.features %}
                <li class="flex items-start">
                  <i data-feather="check" class="text-primary w-4 h-4 mr-2 mt-1"></i>
                  <span class="text-gray-600">{{ feature }}</span>
                </li>
              {% endfor %}
            </ul>
            <button class="w-full bg-primary text-white py-2 rounded-full font-medium hover:bg-opacity-90 transition">Customize Package</button>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>
