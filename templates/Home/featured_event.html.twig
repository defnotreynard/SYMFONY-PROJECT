<section id="featured-event" class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl font-bold text-gray-800 mb-4" data-aos="fade-up">Featured Event</h2>
      <div class="w-20 h-1 bg-primary mx-auto"></div>
    </div>

    {% set event = { title: 'Elegant Garden Wedding', description: 'Our recent garden wedding at a beautiful countryside venue featured full-service coordination, floral arrangements, and photography. The couple wanted a romantic, nature-inspired celebration with 150 guests.', mainImage: 'http://static.photos/wedding/640x360/1', images: ['http://static.photos/wedding/640x360/2', 'http://static.photos/wedding/640x360/3'], tags: ['Catering', 'Floral Design', 'Photography', 'Lighting'] } %}

    <div class="bg-secondary rounded-xl p-6 shadow-sm" data-aos="fade-up">
      <div class="md:flex">
        <div class="md:w-1/2 mb-6 md:mb-0 md:pr-6">
          <div class="grid grid-cols-2 gap-4">
            <img src="{{ event.mainImage }}" alt="{{ event.title }}" class="rounded-lg h-full object-cover" />
            <div class="grid gap-4">
              {% for image in event.images %}
                <img src="{{ image }}" alt="{{ event.title }}" class="rounded-lg h-32 object-cover" />
              {% endfor %}
            </div>
          </div>
        </div>
        <div class="md:w-1/2">
          <h3 class="text-2xl font-bold text-gray-800 mb-4">{{ event.title }}</h3>
          <p class="text-gray-600 mb-4">{{ event.description }}</p>

          <div class="flex flex-wrap gap-2 mb-6">
            {% for tag in event.tags %}
              <span class="bg-accent bg-opacity-30 text-primary px-3 py-1 rounded-full text-sm">{{ tag }}</span>
            {% endfor %}
          </div>

          <a href="#gallery" class="inline-flex items-center text-primary font-medium">View More Photos <i data-feather="arrow-right" class="ml-2 w-4 h-4"></i></a>
        </div>
      </div>
    </div>
  </div>
</section>
