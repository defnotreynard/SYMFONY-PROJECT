{% block body %}
  <!-- About Section -->
  <section id="about" class="py-16 bg-secondary">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-gray-800 mb-4" data-aos="fade-up">About JOJEANS Events</h2>
        <div class="w-20 h-1 bg-primary mx-auto"></div>
      </div>

      <div class="md:flex items-center">
        <div class="md:w-1/2 mb-8 md:mb-0 md:pr-10" data-aos="fade-right">
          <img src="http://static.photos/office/640x360/1" alt="Our Team" class="rounded-xl shadow-lg" />
        </div>
        <div class="md:w-1/2" data-aos="fade-left">
          <p class="text-gray-600 mb-6">Based in the heart of Dumaguete, JOJEANS Events specializes in creating memorable celebrations that reflect your unique style. We understand the vibrant event culture of our city and the challenges that come with planning the perfect occasion.</p>
          <p class="text-gray-600 mb-8">Our mission is to simplify event planning by offering comprehensive services and seamless booking in one platform, allowing you to focus on enjoying your special day.</p>

          <div class="space-y-6">
            <div class="flex items-start">
              <div class="flex-shrink-0 bg-primary bg-opacity-10 p-2 rounded-full">
                <i data-feather="check-circle" class="text-primary w-6 h-6"></i>
              </div>
              <div class="ml-4">
                <h4 class="text-lg font-medium text-gray-800">Plan</h4>
                <p class="text-gray-600">Consult with our experts to outline your vision</p>
              </div>
            </div>
            <div class="flex items-start">
              <div class="flex-shrink-0 bg-primary bg-opacity-10 p-2 rounded-full">
                <i data-feather="check-circle" class="text-primary w-6 h-6"></i>
              </div>
              <div class="ml-4">
                <h4 class="text-lg font-medium text-gray-800">Choose Services</h4>
                <p class="text-gray-600">Select from our curated options or create custom packages</p>
              </div>
            </div>
            <div class="flex items-start">
              <div class="flex-shrink-0 bg-primary bg-opacity-10 p-2 rounded-full">
                <i data-feather="check-circle" class="text-primary w-6 h-6"></i>
              </div>
              <div class="ml-4">
                <h4 class="text-lg font-medium text-gray-800">Book</h4>
                <p class="text-gray-600">Secure your date with our easy online system</p>
              </div>
            </div>
            <div class="flex items-start">
              <div class="flex-shrink-0 bg-primary bg-opacity-10 p-2 rounded-full">
                <i data-feather="check-circle" class="text-primary w-6 h-6"></i>
              </div>
              <div class="ml-4">
                <h4 class="text-lg font-medium text-gray-800">Celebrate</h4>
                <p class="text-gray-600">Enjoy your perfectly executed event</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
{% endblock %}
