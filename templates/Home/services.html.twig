{% block body %}
  <!-- Services Section -->
  <section id="services" class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-gray-800 mb-4" data-aos="fade-up">Our Services</h2>
        <div class="w-20 h-1 bg-primary mx-auto"></div>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Service 1 -->
        <div class="service-card bg-white p-6 rounded-xl shadow-md transition duration-300" data-aos="fade-up" data-aos-delay="100">
          <div class="bg-primary bg-opacity-10 p-3 rounded-full w-12 h-12 flex items-center justify-center mb-4">
            <i data-feather="coffee" class="text-primary w-6 h-6"></i>
          </div>
          <h3 class="text-xl font-bold text-gray-800 mb-3">Catering</h3>
          <p class="text-gray-600 mb-4">Exquisite menus tailored to your event, from cocktail receptions to full-course dinners.</p>
          <button class="text-primary font-medium flex items-center">Add to Bundle <i data-feather="plus" class="ml-2 w-4 h-4"></i></button>
        </div>

        <!-- Service 2 -->
        <div class="service-card bg-white p-6 rounded-xl shadow-md transition duration-300" data-aos="fade-up" data-aos-delay="200">
          <div class="bg-primary bg-opacity-10 p-3 rounded-full w-12 h-12 flex items-center justify-center mb-4">
            <i data-feather="feather" class="text-primary w-6 h-6"></i>
          </div>
          <h3 class="text-xl font-bold text-gray-800 mb-3">Styling & Decor</h3>
          <p class="text-gray-600 mb-4">Transform your venue with our creative designs and thematic decorations.</p>
          <button class="text-primary font-medium flex items-center">Add to Bundle <i data-feather="plus" class="ml-2 w-4 h-4"></i></button>
        </div>

        <!-- Service 3 -->
        <div class="service-card bg-white p-6 rounded-xl shadow-md transition duration-300" data-aos="fade-up" data-aos-delay="300">
          <div class="bg-primary bg-opacity-10 p-3 rounded-full w-12 h-12 flex items-center justify-center mb-4">
            <i data-feather="camera" class="text-primary w-6 h-6"></i>
          </div>
          <h3 class="text-xl font-bold text-gray-800 mb-3">Photo & Video</h3>
          <p class="text-gray-600 mb-4">Professional photography and videography to capture your special moments.</p>
          <button class="text-primary font-medium flex items-center">Add to Bundle <i data-feather="plus" class="ml-2 w-4 h-4"></i></button>
        </div>

        <!-- Service 4 -->
        <div class="service-card bg-white p-6 rounded-xl shadow-md transition duration-300" data-aos="fade-up" data-aos-delay="100">
          <div class="bg-primary bg-opacity-10 p-3 rounded-full w-12 h-12 flex items-center justify-center mb-4">
            <i data-feather="music" class="text-primary w-6 h-6"></i>
          </div>
          <h3 class="text-xl font-bold text-gray-800 mb-3">Sounds & Lights</h3>
          <p class="text-gray-600 mb-4">Premium audio equipment and lighting effects to set the perfect mood.</p>
          <button class="text-primary font-medium flex items-center">Add to Bundle <i data-feather="plus" class="ml-2 w-4 h-4"></i></button>
        </div>

        <!-- Service 5 -->
        <div class="service-card bg-white p-6 rounded-xl shadow-md transition duration-300" data-aos="fade-up" data-aos-delay="200">
          <div class="bg-primary bg-opacity-10 p-3 rounded-full w-12 h-12 flex items-center justify-center mb-4">
            <i data-feather="gift" class="text-primary w-6 h-6"></i>
          </div>
          <h3 class="text-xl font-bold text-gray-800 mb-3">Cakes & Desserts</h3>
          <p class="text-gray-600 mb-4">Custom-designed cakes and sweet treats to delight your guests.</p>
          <button class="text-primary font-medium flex items-center">Add to Bundle <i data-feather="plus" class="ml-2 w-4 h-4"></i></button>
        </div>

        <!-- Service 6 -->
        <div class="service-card bg-white p-6 rounded-xl shadow-md transition duration-300" data-aos="fade-up" data-aos-delay="300">
          <div class="bg-primary bg-opacity-10 p-3 rounded-full w-12 h-12 flex items-center justify-center mb-4">
            <i data-feather="mail" class="text-primary w-6 h-6"></i>
          </div>
          <h3 class="text-xl font-bold text-gray-800 mb-3">Invitations</h3>
          <p class="text-gray-600 mb-4">Elegant printed or digital invitations to announce your event in style.</p>
          <button class="text-primary font-medium flex items-center">Add to Bundle <i data-feather="plus" class="ml-2 w-4 h-4"></i></button>
        </div>
      </div>
    </div>
  </section>
{% endblock %}
